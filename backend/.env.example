# Copy to .env and fill in real values. NEVER commit .env.

# Required. The application refuses to start without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Local development uses SQLite by default when this is unset.
# Point at PostgreSQL only for staging/production — never at the production
# database from a developer machine.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "production" in deployed environments. Controls secure/SameSite cookie
# flags and suppresses internal error details in API responses.
ENV=development

# Password for the admin@dlsau.edu.ph account, used only when it does not exist
# yet. If unset, a random one is generated and printed to the console on first
# start. Must meet the 12-character minimum.
# ADMIN_SEED_PASSWORD=

# Comma-separated list of additional allowed browser origins.
# ALLOWED_ORIGINS=https://your-frontend.example.com

# Where uploaded profile photos are written. Defaults to ./uploads, which is
# right for local development. A deployed container's filesystem does not
# survive a redeploy, so in production this must point at a mounted volume --
# on Railway, add a volume and set this to its mount path, e.g. /app/uploads.
# The URL (/uploads/profiles/...) and the stored database value do not change
# with it, so repointing this does not invalidate existing rows.
# UPLOAD_DIR=/app/uploads

# --- Optional: OTP delivery ---
# Outside production an unsent OTP is printed to the console, so none of the
# following is needed for local development.

# SMS, via the TextBee gateway app running on a handset.
# TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=

# Email. Providers are tried in this order, first success wins:
# SendGrid, then Resend, then the Google Apps Script relay, then plain SMTP.
# SENDGRID_API_KEY=
# SENDGRID_SENDER_EMAIL=
# RESEND_API_KEY=
# Defaults to onboarding@resend.dev, which only delivers to the Resend account
# owner. Set a verified sender to reach anyone else.
# RESEND_SENDER_EMAIL=
# GOOGLE_SCRIPT_URL=
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
