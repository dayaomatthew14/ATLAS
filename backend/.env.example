# Copy to .env and fill in real values. NEVER commit .env.

# Required. The application refuses to start without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Local development uses SQLite by default when this is unset.
# Point at PostgreSQL only for staging/production — never at the production
# database from a developer machine.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "production" in deployed environments. Controls secure/SameSite cookie
# flags and suppresses internal error details in API responses.
ENV=development

# Password for the admin@dlsau.edu.ph account, used only when it does not exist
# yet. If unset, a random one is generated and printed to the console on first
# start. Must meet the 12-character minimum.
# ADMIN_SEED_PASSWORD=

# Comma-separated list of additional allowed browser origins.
# ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Optional: OTP delivery ---
# TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SENDGRID_API_KEY=
# SENDGRID_SENDER_EMAIL=
# RESEND_API_KEY=
# GOOGLE_SCRIPT_URL=
